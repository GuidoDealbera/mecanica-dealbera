# `typeorm` declara `better-sqlite3@^8 … ^12` como peer y el proyecto usa la 13.
# El conflicto es de metadatos: la API que usa typeorm no cambió, y la 13 es la
# que hay que usar por un motivo concreto.
#
# La 12 descarga un binario atado al **ABI de Node** (`prebuild-install`), así
# que dentro de Electron falla con `NODE_MODULE_VERSION 137` y habría que
# recompilarla en cada instalación para poder correr `npm run dev`. La 13 trae
# binarios **N-API** dentro del paquete, que son estables entre Node y Electron:
# instala en segundos, sin toolchain y sin recompilar. Verificado: con la 12 la
# aplicación no abre la base; con la 13 arranca y migra sin tocar nada.
#
# Sin esta bandera, cualquier `npm install` falla con ERESOLVE.
legacy-peer-deps=true

# Que un desajuste de versión de Node falle **al instalar** y no en tiempo de
# ejecución. Sin esto, `npm ci` sólo advierte: el CI instaló jsdom 30 y undici 8
# sobre Node 20 —que ambos declaran no soportar— y el fallo apareció recién al
# levantar el entorno de los tests de componentes, con un `TypeError` interno de
# undici que no decía nada del verdadero problema.
engine-strict=true
