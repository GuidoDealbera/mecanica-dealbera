# typeorm declara `sqlite3@^5.0.3` como peer opcional y el proyecto usa el 6,
# que es el que trae los binarios precompilados para Node 22 / Electron 30. El
# conflicto es sólo de metadatos: la API que usa typeorm no cambió entre el 5 y
# el 6, y la aplicación funciona con el 6 desde siempre.
#
# Sin esto, cualquier `npm install` (incluso agregar una dependencia sin
# relación) falla con ERESOLVE y hay que acordarse de la bandera a mano.
legacy-peer-deps=true

# Que un desajuste de versión de Node falle **al instalar** y no en tiempo de
# ejecución. Sin esto, `npm ci` sólo advierte: el CI instaló jsdom 30 y undici 8
# sobre Node 20 —que ambos declaran no soportar— y el fallo apareció recién al
# levantar el entorno de los tests de componentes, con un `TypeError` interno de
# undici que no decía nada del verdadero problema.
engine-strict=true
