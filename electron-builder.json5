// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",

  appId: "com.dealbera.mecanica",
  productName: "Mecánica Dealbera",
  asar: true,

  // No recompilar los módulos nativos al empaquetar.
  //
  // El único que hay es `better-sqlite3`, y su versión 13 trae binarios
  // **N-API** dentro del paquete, que son estables entre Node y Electron: no
  // necesitan recompilarse. electron-builder no lo sabe y lo intenta igual, lo
  // que hace fallar el build con `node-gyp failed to rebuild` en cualquier
  // máquina sin toolchain de C++ instalado.
  //
  // Si algún día entra un módulo nativo que **sí** dependa del ABI, hay que
  // volver a poner esto en true y asegurarse de que el runner tenga el
  // toolchain.
  npmRebuild: false,

  // De dónde salen las notas que la aplicación muestra en el cartel de
  // actualización. Las genera `scripts/notas-de-version.mjs` a partir del
  // CHANGELOG, tomando **sólo** la sección de la versión que se publica.
  releaseInfo: {
    releaseNotesFile: "build/release-notes.md",
  },

  publish: {
    provider: "github",
    owner: "GuidoDealbera",
    repo: "mecanica-dealbera",
    releaseType: "release",
  },

  directories: {
    // Relativa, y en `.gitignore`.
    //
    // Era una ruta absoluta con un nombre de usuario adentro, en un archivo
    // versionado: `npm run build` en cualquier otra maquina escribia en una
    // carpeta que no existe. El flujo de publicacion andaba solo porque la
    // pisaba con `--config.directories.output=release`.
    //
    // Quien quiera otra carpeta la pasa por parametro, que es para lo que esta
    // ese flag.
    output: "release",
  },

  files: ["dist", "dist-electron"],

  extraResources: [
    {
      from: "electron/splash.html",
      to: "splash.html",
    },
    {
      from: "electron/images",
      to: "images",
    },
  ],

  win: {
    // **El instalador no se firma, y hoy no se puede.**
    //
    // Comprobado sobre el ejecutable armado: `Get-AuthenticodeSignature` dice
    // `NotSigned`. El "signing with signtool.exe" que aparece en el registro del
    // build engaña: electron-builder lo escribe igual y saltea la firma cuando
    // no encuentra certificado. El resultado es determinista —siempre sin
    // firmar—, no depende de la máquina que compile.
    //
    // Consecuencia: SmartScreen avisa "editor desconocido" en cada instalación,
    // y el usuario tiene que entrar en "Más información → Ejecutar de todas
    // formas". Nada lo evita sin un certificado de firma de código (OV o EV),
    // que es una compra con verificación de identidad, no una opción de
    // configuración.
    //
    // **Cuando haya certificado no hay que tocar este archivo**:
    // electron-builder toma `CSC_LINK` (ruta o base64 del .pfx) y
    // `CSC_KEY_PASSWORD` del entorno. En el flujo de publicación van como
    // secretos del repositorio.
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    // Un `.ico` de verdad, con 16, 32, 48 y 256. Era el PNG de 512, que
    // electron-builder convierte por su cuenta: el icono que el usuario mira
    // todos los dias en la barra de tareas y en el explorador merece las
    // resoluciones que Windows va a pedir, y no una sola reescalada al vuelo.
    //
    // Se genero una vez con `png-to-ico` a partir de `public/logo-grande.png` y
    // quedo versionado. La herramienta no quedo como dependencia: se usa cuando
    // cambia el logo, no en cada build.
    icon: "build/icon.ico",
    artifactName: "${productName}-Windows-${version}-Setup.${ext}",
  },

  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "Mecánica Dealbera",
  },

  // **No se empaqueta para macOS ni para Linux.**
  //
  // Habia objetivos `dmg` y `AppImage` configurados, y nadie los probo nunca. El
  // codigo asume Windows en varios lados —los respaldos van a `Documents`, el
  // traslado desde la base vieja, `signtool`—, asi que lo mas probable es que
  // esos artefactos no funcionen.
  //
  // Un artefacto que se puede construir y nunca se probo es peor que no tenerlo:
  // da a entender que la plataforma esta soportada. Cuando se decida soportarla,
  // el trabajo no es agregar estas diez lineas sino revisar esas suposiciones.
}
