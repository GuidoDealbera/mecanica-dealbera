{
  "name": "mecanica-dealbera",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "description": "Sistema de gestión para Mecánica Dealbera",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuidoDealbera/mecanica-dealbera"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "release": "tsc && vite build && electron-builder --publish always",
    "lint": "eslint src electron --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "migration:generate": "cross-env npx tsx ./node_modules/typeorm/cli.js migration:generate -d electron/DataBase/data-source.cli.ts",
    "migration:run": "cross-env npx tsx ./node_modules/typeorm/cli.js migration:run -d electron/DataBase/data-source.cli.ts",
    "migration:revert": "cross-env npx tsx ./node_modules/typeorm/cli.js migration:revert -d electron/DataBase/data-source.cli.ts",
    "migration:show": "cross-env npx tsx ./node_modules/typeorm/cli.js migration:show -d electron/DataBase/data-source.cli.ts"
  },
  "dependencies": {
    "@heroui/react": "^2.8.3",
    "@reduxjs/toolkit": "^2.9.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.18",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.23.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-is": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.9.2",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^4.1.12",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
